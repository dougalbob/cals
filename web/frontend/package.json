{
  "name": "cals-frontend",
  "private": true,
  "version": "0.1.0-spike",
  "type": "module",
  "description": "Phase 11 foundation for the React frontend rebuild (still non-default; production route is temporary /next/).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:preview && playwright test",
    "test:e2e:phone": "npm run build:preview && playwright test --project=phone",
    "build:preview": "VITE_PREVIEW=1 vite build --outDir preview",
    "serve:preview": "node serve-preview.mjs",
    "lint": "eslint --ext .ts,.tsx src e2e playwright.config.ts vite.config.ts --max-warnings 0",
    "build:go": "npm run typecheck && vite build --mode go"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
